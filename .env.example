# Copy this file to  backend/.env  and fill in real values.
# NEVER commit the real .env (it's in .gitignore).

# ── App ──
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL) ──
# These match the docker-compose service. If running Postgres locally
# (not Docker), set DB_HOST=localhost and use the role you created with createuser.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agromart
DB_USER=agromart
DB_PASS=change_me_to_a_real_password

# ── Auth (needed from Phase 1 onward) ──
JWT_SECRET=generate_a_long_random_string_here

# ── External services (needed later; leave blank for now) ──
GEMINI_API_KEY=
WEATHER_API_KEY=
SMS_PROVIDER=log
PAYMENT_PROVIDER=mock
